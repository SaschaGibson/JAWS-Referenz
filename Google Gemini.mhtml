; Sammelt diverse technische Informationen zum Element unter dem virtuellen=
 Cursor
; und zeigt diese im Virtual Viewer an.
Script Web_InspectCurrentElement ()
    ; --- Sicherheitspr=C3=BCfung: Nur im virtuellen Modus ausf=C3=BChren -=
--
    ; Stellt sicher, dass das Skript nur in Webseiten, PDFs etc. l=C3=A4uft=
, wo der virtuelle Cursor aktiv ist.
	if !default.IsVirtualPCCursor() then
        ; Gibt eine Standard-Fehlermeldung aus, wenn der virtuelle Cursor n=
icht aktiv ist.
		default.SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L,=
 cmsgFeatureRequiresVirtualCursor_S)
		return
	endIf

	; --- Variablen deklarieren ---
	var object domNode, attributes, attr
	var string nodeText, nodeXML
	var string msaaName, msaaValue, msaaRole, msaaState, msaaDesc
	var int i, attrCount

	; --- 1. DATEN SAMMELN: DOM-Informationen ---

    ; Dies ist die zentrale Funktion. Sie greift auf das Element zu, das si=
ch direkt
    ; an der aktuellen Position des virtuellen Cursors befindet, und gibt e=
s als DOM-Knoten-Objekt zur=C3=BCck.
	domNode =3D default.GetXMLDomNodeFromVirtualCursor()

    ; Wenn kein g=C3=BCltiges Objekt gefunden wurde (z.B. auf einer leeren =
Zeile),
    ; wird eine Fehlermeldung ausgegeben und das Skript beendet.
	if !domNode then
		default.Say("Kein DOM-Knoten unter dem virtuellen Cursor gefunden.", OT_E=
RROR)
		return
	endIf

	; Holt den reinen sichtbaren Text des Knotens, ohne untergeordnete Element=
e.
	nodeText =3D default.GetXMLDomNodeText(domNode)

	; Holt die Attribut-Sammlung des DOM-Knotens.
	attributes =3D domNode.attributes
    ; Ermittelt die Anzahl der Attribute f=C3=BCr die sp=C3=A4tere Schleife=
.
	attrCount =3D attributes.length

	; Holt den vollst=C3=A4ndigen XML-Code des aktuellen Knotens inklusive sei=
ner Kind-Elemente.
    ; Dies ist n=C3=BCtzlich, um die genaue Struktur zu sehen.
	nodeXML =3D domNode.xml

	; --- 2. DATEN SAMMELN: MSAA-Informationen ---
    ; Diese Informationen stammen aus der Microsoft Active Accessibility AP=
I und k=C3=B6nnen
    ; sich von den DOM-Informationen unterscheiden. Sie bieten eine alterna=
tive Sicht auf das Objekt.

	msaaName =3D default.GetObjectName() ; Der zug=C3=A4ngliche Name (oft das =
Label).
	msaaValue =3D default.GetObjectValue() ; Der aktuelle Wert (z.B. bei einem=
 Eingabefeld).
	msaaRole =3D default.GetObjectRole(ROLE_SYSTEM_CLIENT, 1) ; Die Rolle (z.B=
. "Schaltfl=C3=A4che"), als Text ausgegeben.
	msaaState =3D default.GetObjectState(STATE_SYSTEM_NORMAL, 1) ; Der Zustand=
 (z.B. "aktiviert", "ausgeblendet"), als Text ausgegeben.
	msaaDesc =3D default.GetObjectDescription() ; Die zug=C3=A4ngliche Beschre=
ibung.

	; --- 3. AUSGABE VORBEREITEN UND ANZEIGEN ---

    ; L=C3=B6scht den Inhalt des Virtual Viewers, um eine saubere Anzeige z=
u gew=C3=A4hrleisten.
	default.UserBufferClear()
	default.UserBufferAddText ("Web Element Inspector")
	default.UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cS=
cBufferNewLine)

	; Abschnitt 1: Allgemeine Infos
	default.UserBufferAddText ("1. Allgemeine Infos" + cScBufferNewLine)
	self.Inspector_AddInfo("Tag-Name", domNode.nodeName)
	self.Inspector_AddInfo("Sichtbarer Text", nodeText)
	default.UserBufferAddText (cScBufferNewLine)

	; Abschnitt 2: MSAA-Eigenschaften
	default.UserBufferAddText ("2. MSAA-Eigenschaften" + cScBufferNewLine)
	self.Inspector_AddInfo("Name", msaaName)
	self.Inspector_AddInfo("Wert", msaaValue)
	self.Inspector_AddInfo("Rolle", msaaRole)
	self.Inspector_AddInfo("Status", msaaState)
	self.Inspector_AddInfo("Beschreibung", msaaDesc)
	default.UserBufferAddText (cScBufferNewLine)

	; Abschnitt 3: Alle HTML/ARIA Attribute durchlaufen und ausgeben
	default.UserBufferAddText ("3. HTML/ARIA Attribute (" + default.IntToStrin=
g(attrCount) + ")" + cScBufferNewLine)
	if attrCount &gt; 0 then
        ; Schleife von 0 bis zur Anzahl der Attribute minus 1 (da die Z=C3=
=A4hlung bei 0 beginnt).
		For i =3D 0 to attrCount - 1
            ; Holt das einzelne Attribut-Objekt am aktuellen Index.
			attr =3D attributes.item(i)
			if attr then
                ; Gibt Name und Wert des Attributs aus (z.B. "- id: 'main-c=
ontent'").
				self.Inspector_AddInfo(attr.nodeName, "'" + attr.nodeValue + "'")
			endIf
		EndFor
	else
		default.UserBufferAddText("- (keine)" + cScBufferNewLine)
	endIf
	default.UserBufferAddText (cScBufferNewLine)

	; Abschnitt 4: Kompletter XML-Code des Knotens
	default.UserBufferAddText ("4. DOM-Knoten (XML-Ausschnitt)" + cScBufferNew=
Line)
	default.UserBufferAddText (nodeXML)
	default.UserBufferAddText (cScBufferNewLine)


	; --- Viewer aktivieren und Fokus setzen ---
	default.UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cS=
cBufferNewLine)
    ; F=C3=BCgt den Standard-Schlie=C3=9Fen-Link am Ende des Viewers hinzu.
	default.UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
    ; Zeigt den Virtual Viewer an.
	default.UserBufferActivate ()
    ; Setzt den Cursor an den Anfang des Inhalts.
	default.JAWSTopOfFile ()
    ; Liest die erste Zeile vor, um dem Nutzer Feedback zu geben, dass das =
Skript erfolgreich war.
	default.SayLine ()

EndScript
