=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; F=C3=BCgt eine Zeile mit einer Z=C3=A4hlung zum UserBuffer hinzu.
Void Function Summary_AddCount (string sLabel, int iCount)
    if iCount &gt;=3D 0 then
        UserBufferAddText ("- " + sLabel + ": " + IntToString(iCount) + cSc=
BufferNewLine)
    endif
EndFunction

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
