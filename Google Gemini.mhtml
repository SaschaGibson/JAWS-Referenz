; Sammelt MSAA-Informationen zum aktuellen Objekt und zeigt diese an.
Script Web_InspectCurrentElement ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var string msaaName
	var string msaaValue
	var int    msaaRoleCode     ; Variable f=C3=BCr den numerischen Rollen-Cod=
e
	var string msaaRoleText     ; Variable f=C3=BCr den lesbaren Rollen-Text
	var int    msaaStateCode    ; Variable f=C3=BCr den numerischen Status-Cod=
e
	var string msaaStateText    ; Variable f=C3=BCr den lesbaren Status-Text
	var string msaaDesc

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---

	; Sicherheitspr=C3=BCfung: Nur im virtuellen Modus ausf=C3=BChren
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf

	; --- Daten sammeln: MSAA-Informationen vom aktuellen Objekt ---
	msaaName =3D GetObjectName()
	msaaValue =3D GetObjectValue()
	msaaDesc =3D GetObjectDescription()
=09
	; Holen der numerischen Codes f=C3=BCr Rolle und Status
	msaaRoleCode =3D GetObjectRole()
	msaaStateCode =3D GetObjectState()
=09
	; Umwandeln der Codes in lesbaren Text
	msaaRoleText =3D GetRoleText(msaaRoleCode)
	msaaStateText =3D GetStateText(msaaStateCode)


	; --- Ausgabe im Virtual Viewer vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("Web Element Inspector (MSAA-Modus)")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cScBuffe=
rNewLine)

	Inspector_AddInfo("Name", msaaName)
	Inspector_AddInfo("Wert", msaaValue)
	Inspector_AddInfo("Rolle", msaaRoleText)
	Inspector_AddInfo("Status", msaaStateText)
	Inspector_AddInfo("Beschreibung", msaaDesc)

	; --- Viewer aktivieren und Fokus setzen ---
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cScBuffe=
rNewLine)
	UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	UserBufferActivate ()
	JAWSTopOfFile ()
	SayLine ()

EndScript
