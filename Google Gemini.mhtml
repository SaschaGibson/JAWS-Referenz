; Sammelt XML/DOM-Informationen zum Element unter dem virtuellen Cursor
; und zeigt diese im Virtual Viewer an.
Script Web_InspectCurrentElement_XML ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var object xmlDoc
	var object currentNode
	var object attributes
	var object attr
	var string screenXml
	var string uniqueId
	var string xPathQuery
	var int i
	var int attrCount

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---

	; Sicherheitspr=C3=BCfung
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf

	; --- Schritt A: Gesamten Bildschirminhalt als XML-String abrufen ---
	screenXml =3D GetScreenXML ()
	if StringIsBlank(screenXml) then
		Say("Konnte keinen XML-Code vom Bildschirm abrufen.", OT_ERROR)
		return
	endif

	; --- Schritt B: Microsoft XML DOM-Objekt erstellen und XML laden ---
	xmlDoc =3D CreateObject("msxml2.DOMDocument.6.0")
	if !xmlDoc then
		Say("Konnte das MSXML-Objekt nicht erstellen. Ist es auf dem System insta=
lliert?", OT_ERROR)
		return
	endif
=09
	xmlDoc.loadXML(screenXml)
=09
	; Pr=C3=BCfen, ob das Laden erfolgreich war
	if xmlDoc.parseError.errorCode !=3D 0 then
		Say("Fehler beim Parsen des XML: " + xmlDoc.parseError.reason, OT_ERROR)
		return
	endif

	; --- Schritt C: Aktuelles Element identifizieren ---
	; Wir holen die IA2UniqueId des aktuellen Elements als Br=C3=BCcke zu unse=
rem XML-Dokument
	uniqueId =3D GetObjectIA2UniqueId()
	if StringIsBlank(uniqueId) then
		Say("Konnte keine eindeutige ID f=C3=BCr das aktuelle Element finden.", O=
T_ERROR)
		return
	endif

	; --- Schritt D: Knoten im XML-Dokument =C3=BCber die ID finden (XPath-Abf=
rage) ---
	xPathQuery =3D "//*[@IA2UniqueId=3D'" + uniqueId + "']"
	currentNode =3D xmlDoc.selectSingleNode(xPathQuery)

	if !currentNode then
		Say("Konnte den Knoten mit der ID '" + uniqueId + "' im XML-Dokument nich=
t finden.", OT_ERROR)
		return
	endif

	; --- Schritt E: Informationen aus dem gefundenen Knoten extrahieren ---
	attributes =3D currentNode.attributes
	attrCount =3D attributes.length

	; --- Ausgabe vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("Web Element Inspector (XML/DOM-Modus)")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cScBuffe=
rNewLine)

	; Allgemeine Infos
	UserBufferAddText ("1. Allgemeine Infos" + cScBufferNewLine)
	Inspector_AddInfo("Tag-Name", currentNode.nodeName)
	Inspector_AddInfo("Sichtbarer Text", currentNode.text)
	UserBufferAddText (cScBufferNewLine)

	; Attribute
	UserBufferAddText ("2. Attribute (" + IntToString(attrCount) + ")" + cScBu=
fferNewLine)
	if attrCount &gt; 0 then
		For i =3D 0 to attrCount - 1
			attr =3D attributes.item(i)
			if attr then
				Inspector_AddInfo(attr.nodeName, "'" + attr.nodeValue + "'")
			endIf
		EndFor
	else
		UserBufferAddText("- (keine)" + cScBufferNewLine)
	endIf
	UserBufferAddText (cScBufferNewLine)

	; XML-Code des Knotens
	UserBufferAddText ("3. Knoten XML" + cScBufferNewLine)
	UserBufferAddText (currentNode.xml)
	UserBufferAddText (cScBufferNewLine)


	; --- Viewer aktivieren ---
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cScBuffe=
rNewLine)
	UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	UserBufferActivate ()
	JAWSTopOfFile ()
	SayLine ()

EndScript
