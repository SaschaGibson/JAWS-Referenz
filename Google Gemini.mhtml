; Analysiert das aktuelle Element mit GetElementXML() und generiert passend=
e Code-Beispiele.
Script GenerateElementAction ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var object xmlDoc
	var object xmlNode
	var object attributes
	var object attr
	var string elementXml
	var string fsIdHex
	var int    fsIdDec
	var string errorMessage
	var int    i
	var int    foundFsId ; Unsere neue "Flag"-Variable

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---
=09
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf
=09
	; --- Schritt A: XML des Elements am virtuellen Cursor direkt abrufen ---
	elementXml =3D GetElementXML (0) ; 0 f=C3=BCr das aktuelle Element

	if StringIsBlank(elementXml) then
		Say("Konnte mit GetElementXML keinen XML-Code f=C3=BCr das aktuelle Eleme=
nt abrufen.", OT_ERROR)
		return
	endif
=09
	; --- Schritt B: fsID extrahieren (robuste Methode) ---
	xmlDoc =3D CreateObject("msxml2.DOMDocument.6.0")
	if !xmlDoc then
		Say("Konnte das MSXML-Objekt nicht erstellen.", OT_ERROR)
		return
	endif
=09
	xmlDoc.loadXML(elementXml)
	if xmlDoc.parseError.errorCode !=3D 0 then
		errorMessage =3D FormatString("Fehler beim Parsen des Element-XML: %1", x=
mlDoc.parseError.reason)
		Say(errorMessage, OT_ERROR)
		return
	endif

	xmlNode =3D xmlDoc.documentElement
	if xmlNode then
		foundFsId =3D 0 ; Flag initialisieren
		attributes =3D xmlNode.attributes
		For i =3D 0 to attributes.length - 1
			if !foundFsId then ; Nur ausf=C3=BChren, wenn wir die ID noch nicht habe=
n
				attr =3D attributes.item(i)
				if StringUpper(attr.nodeName) =3D=3D "FSID" then
					fsIdHex =3D attr.nodeValue
					fsIdDec =3D HexToDec(fsIdHex)
					foundFsId =3D 1 ; Flag setzen, damit wir nicht weitersuchen
				endif
			endif
		EndFor
	endif

	; --- Ausgabe vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("Script-Assistent: Code-Vorschl=C3=A4ge (via GetElement=
XML)")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)

	; --- Logik zur Code-Generierung ---
	if fsIdDec !=3D 0 then
		UserBufferAddText ("Erfolg! fsID gefunden: " + fsIdHex + cScBufferNewLine=
)
