; Ultimativer Test: Behandelt BEIDE R=C3=BCckgabewerte als Integer.

Include "HjGlobal.jsh"
Include "HjConst.jsh"

Script TestFinalHandleHypothese ()
    var int domNodeHandle
    var int finalObjectHandle

    ; Schritt 1: Hole das erste Handle
    domNodeHandle =3D GetXMLDomNodeFromVirtualCursor()

    if domNodeHandle !=3D 0 then
        ; Schritt 2: Versuche, das erste Handle in ein zweites umzuwandeln
        finalObjectHandle =3D DOMNodeFromHandle(domNodeHandle)
        if finalObjectHandle !=3D 0 then
            Say("Test V3 kompiliert! Zweites Handle empfangen.", OT_MESSAGE=
)
        else
            Say("Test V3 kompiliert, aber zweites Handle ist null.", OT_ERR=
OR)
        endif
    else
        Say("Test V3 kompiliert, aber erstes Handle ist null.", OT_ERROR)
    endif
EndScript
