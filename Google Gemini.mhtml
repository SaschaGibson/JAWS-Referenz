; Sammelt MSAA-Informationen zum aktuellen Objekt und zeigt diese an.
Script Web_InspectCurrentElement ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var object currentObject
	var string msaaName
	var string msaaValue
	var string msaaRole
	var string msaaState
	var string msaaDesc

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---

	; Hole das aktuelle Objekt, egal ob virtueller oder PC-Cursor
	currentObject =3D GetCurrentObject ()

	if !currentObject then
		Say("Kein zug=C3=A4ngliches Objekt am Cursor gefunden.", OT_ERROR)
		return
	endif

	; --- Daten sammeln: MSAA-Informationen ---
	msaaName =3D GetObjectName(currentObject)
	msaaValue =3D GetObjectValue(currentObject)
	msaaRole =3D GetObjectRole(currentObject, 1) ; 1 =3D Text-Repr=C3=A4sentat=
ion
	msaaState =3D GetObjectState(currentObject, 1) ; 1 =3D Text-Repr=C3=A4sent=
ation
	msaaDesc =3D GetObjectDescription(currentObject)

	; --- Ausgabe im Virtual Viewer vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("Web Element Inspector (MSAA-Modus)")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cScBuffe=
rNewLine)

	Inspector_AddInfo("Name", msaaName)
	Inspector_AddInfo("Wert", msaaValue)
	Inspector_AddInfo("Rolle", msaaRole)
	Inspector_AddInfo("Status", msaaState)
