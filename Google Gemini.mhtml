Script GeheZuUeberschrift ()
    var string headingsList
    var int selectedIndex
    var int i

    ; 1. Alle =C3=9Cberschriften sammeln (z.B. in einer durch | getrennten =
Liste)
    For i =3D 1 to GetHeadingCount(0)
        MoveToHeading (i)
        headingsList =3D headingsList + GetCurrentLine () + "|"
    EndFor

    ; 2. Den Auswahldialog anzeigen
    selectedIndex =3D DlgSelectItemInList ("Bitte w=C3=A4hlen Sie eine =C3=
=9Cberschrift:", headingsList, "|", 0)

    ; 3. Zur ausgew=C3=A4hlten =C3=9Cberschrift springen
    if selectedIndex &gt; 0 then
        MoveToHeading (selectedIndex)
    endif
EndScript
