; Interne Hilfsfunktionen
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; F=C3=BCgt eine Zeile mit Code zum UserBuffer hinzu, sauber einger=C3=BCck=
t.
Void Function Assistant_AddCodeLine (string sCode)
    UserBufferAddText ("    " + sCode + cScBufferNewLine)
EndFunction

; Extrahiert den Wert eines bestimmten Attributs aus einem XML-String.
string Function Assistant_ExtractXMLAttribute (string xml, string attribute=
Name)
	var int startPos
	var int endPos
	var string tempString
	var string result
=09
	startPos =3D StringContains(xml, " " + attributeName + "=3D\"")
	if startPos &gt; 0 then
		tempString =3D Substring(xml, startPos + StringLength(attributeName) + 3,=
 StringLength(xml))
		endPos =3D StringContains(tempString, "\"")
		if endPos &gt; 1 then
			result =3D Substring(tempString, 1, endPos - 1)
		endif
	endif
	return result
EndFunction

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Hauptskript
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; Analysiert das aktuelle Element mit GetElementXML() und generiert passend=
e Code-Beispiele.
Script GenerateElementAction ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var string elementXml
	var string fsIdHex
	var int    fsIdDec
	var string tagName
	var string elementText
	var string elementName

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---
=09
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf
=09
	elementXml =3D GetElementXML (0)

	if StringIsBlank(elementXml) then
		Say("Konnte mit GetElementXML keinen XML-Code f=C3=BCr das aktuelle Eleme=
nt abrufen.", OT_ERROR)
		return
	endif
=09
	; --- Schritt B: Alle relevanten Attribute extrahieren ---
	fsIdHex =3D Assistant_ExtractXMLAttribute(elementXml, "fsID")
	if !StringIsBlank(fsIdHex) then
		fsIdDec =3D HexToDec(fsIdHex)
	endif
=09
	tagName =3D Assistant_ExtractXMLAttribute(elementXml, "fsTag")
	elementText =3D Assistant_ExtractXMLAttribute(elementXml, "fsText")
	elementName =3D Assistant_ExtractXMLAttribute(elementXml, "name")


	; --- Ausgabe vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("Script-Assistent: Code-Vorschl=C3=A4ge")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)

	; --- Logik zur Code-Generierung ---
	if fsIdDec !=3D 0 then
		UserBufferAddText ("Priorit=C3=A4t 1: Aktion =C3=BCber fsID (stabilste Me=
thode f=C3=BCr diese Sitzung)" + cScBufferNewLine)
		Assistant_AddCodeLine ("; HINWEIS: Die fsID (" + fsIdHex + ") ist dynamis=
ch!")
		Assistant_AddCodeLine ("PerformActionOnElementWithID (" + IntToString(fsI=
dDec) + ", Action_setFocus)")
		Assistant_AddCodeLine ("PerformActionOnElementWithID (" + IntToString(fsI=
dDec) + ", Action_doDefaultAction)")
	else
		UserBufferAddText ("Konnte keine dynamische fsID f=C3=BCr dieses Element =
finden.")
	endif

	UserBufferAddText (cScBufferNewLine + "-----------------------------------=
-----" + cScBufferNewLine)
	UserBufferAddText ("Alternative Vorschl=C3=A4ge (weniger stabil):" + cScBu=
fferNewLine)

	if !StringIsBlank(elementName) then
		UserBufferAddText (cScBufferNewLine + "Vorschlag A: Aktion =C3=BCber Attr=
ibut 'name'" + cScBufferNewLine)
		Assistant_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Action=
_setFocus, \"" + tagName + "\", \"name\", \"" + elementName + "\", 1)")
		Assistant_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Action=
_doDefaultAction, \"" + tagName + "\", \"name\", \"" + elementName + "\", 1=
)")
	endif
=09
	if !StringIsBlank(elementText) then
		UserBufferAddText (cScBufferNewLine + "Vorschlag B: Aktion =C3=BCber sich=
tbaren Text ('fsText')" + cScBufferNewLine)
		Assistant_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Action=
_setFocus, \"" + tagName + "\", \"fsText\", \"" + elementText + "\", 1)")
		Assistant_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Action=
_doDefaultAction, \"" + tagName + "\", \"fsText\", \"" + elementText + "\",=
 1)")
	endif

	if StringIsBlank(elementName) &amp;&amp; StringIsBlank(elementText) then
		UserBufferAddText (cScBufferNewLine + "(Keine alternativen Attribute wie =
'name' oder 'fsText' gefunden.)")
	endif

	; --- Kompletter XML-Code zur manuellen Pr=C3=BCfung ---
	UserBufferAddText (cScBufferNewLine + "-----------------------------------=
-----" + cScBufferNewLine)
	UserBufferAddText ("Kompletter XML-Code des Elements:" + cScBufferNewLine)
	UserBufferAddText (elementXml)


	; --- Viewer aktivieren ---
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)
	UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	UserBufferActivate ()
	JAWSTopOfFile ()
	SayLine ()

EndScript
