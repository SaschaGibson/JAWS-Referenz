; F=C3=BCgt eine Zeile mit Titel und Wert zum UserBuffer hinzu, wenn der We=
rt nicht leer ist.
; Dies vermeidet leere Zeilen in der Ausgabe und h=C3=A4lt den Code =C3=BCb=
ersichtlich.
Void Function Inspector_AddInfo (string sTitle, string sValue)
    ; Pr=C3=BCft, ob der =C3=BCbergebene Wert (sValue) Inhalt hat.
    if !default.StringIsBlank(sValue) then
        ; F=C3=BCgt die formatierte Zeile (z.B. "- Name: OK") zum UserBuffe=
r hinzu.
        default.UserBufferAddText ("- " + sTitle + ": " + sValue + cScBuffe=
rNewLine)
    endIf
EndFunction

