c2340253945-521">Include "hjconst.jsh"

; Deklariert den Dialog aus der .jcf Datei
Dialog MeinTestDialog

Script OeffneDialog ()
    ; Deklarieren der Variablen
    var string sName

    ; Den Dialog aufrufen und auf eine Aktion warten
    if Dialog(MeinTestDialog) then
        ; Wenn der Benutzer "OK" gedr=C3=BCckt hat
        sName =3D GetControlValue(101) ; Wert aus dem Editfeld mit ID 101 h=
olen
        Say("Hallo, " + sName, OT_MESSAGE)
    else
        ; Wenn der Benutzer "Abbrechen" gedr=C3=BCckt hat
        Say("Aktion abgebrochen.", OT_MESSAGE)
    endif
EndScript
