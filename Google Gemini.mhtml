0">; WebInspector.jss
; Stellt geb=C3=BCndelte MSAA- und HTML-Informationen =C3=BCber das aktuell=
 fokussierte Webelement bereit.
; -------------------------------------------------------------------------=
----
; Skriptsprache: Englisch | Kommentare: Deutsch
; Ansatz: Kombiniert MSAA mit der eleganten GetElementDescription()-Funktio=
n.
; Ausgabe: Virtual Viewer (UserBuffer)
; -------------------------------------------------------------------------=
----
; Version: 13.1.0 (2025-09-29) - GetElementDescription integriert
; Autor:   Projekt "JAWS: Webelemente"

Include "HjGlobal.jsh"
Include "HjConst.jsh"
Include "common.jsm"

ScriptFileVersion 2025
ScriptFile "JAWS Web Inspector (MSAA &amp; HTML)"

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Interne Hilfsfunktionen
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; F=C3=BCgt eine Zeile mit Titel und Wert zum UserBuffer hinzu, wenn der We=
rt nicht leer ist.
Void Function Inspector_AddInfo (string sTitle, string sValue)
    if !StringIsBlank(sValue) then
        UserBufferAddText ("- " + sTitle + ": " + sValue + cScBufferNewLine=
)
    endif
EndFunction

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Hauptskript
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; Sammelt MSAA- und HTML-Informationen zum aktuellen Objekt und zeigt diese=
 an.
Script Web_InspectCurrentElement ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var string msaaName
	var string msaaValue
	var int    msaaRoleCode
	var string msaaRoleText
	var string msaaStateText
	var string msaaDesc
	var string htmlDescription

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---

	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf

	; --- Schritt A: MSAA-Informationen sammeln ---
	msaaName =3D GetObjectName()
	msaaValue =3D GetObjectValue()
	msaaDesc =3D GetObjectDescription()
	msaaRoleCode =3D GetObjectRole()
	msaaRoleText =3D GetRoleText(msaaRoleCode)
	msaaStateText =3D GetObjectState()

	; --- Schritt B: HTML-Beschreibung mit der neuen Funktion abrufen ---
	; Parameter: (Anzahl =C3=BCbergeordneter Elemente, Nur-Tag-Namen-Modus)
	; 0, 0 -&gt; Nur aktuelles Element, mit allen Attributen
	htmlDescription =3D GetElementDescription(0, 0)

	; --- Ausgabe vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("JAWS Web Inspector")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)

	; Abschnitt 1: MSAA-Eigenschaften (als schnelle =C3=9Cbersicht)
	UserBufferAddText ("1. MSAA-Eigenschaften" + cScBufferNewLine)
	Inspector_AddInfo("Name", msaaName)
	Inspector_AddInfo("Wert", msaaValue)
	Inspector_AddInfo("Rolle", msaaRoleText)
	Inspector_AddInfo("Status", msaaStateText)
	Inspector_AddInfo("Beschreibung", msaaDesc)

	; Abschnitt 2: Detaillierte HTML-Beschreibung
	UserBufferAddText (cScBufferNewLine + "-----------------------------------=
-----" + cScBufferNewLine)
	UserBufferAddText ("2. HTML-Elementbeschreibung" + cScBufferNewLine)
	if !StringIsBlank(htmlDescription) then
		UserBufferAddText(htmlDescription)
	else
		UserBufferAddText ("(Keine HTML-Beschreibung f=C3=BCr dieses Element verf=
=C3=BCgbar.)")
	endif

	; --- Viewer aktivieren ---
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)
	UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	UserBufferActivate ()
	JAWSTopOfFile ()
	SayLine ()
