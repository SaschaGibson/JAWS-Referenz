; Liefert kompaktes Label aus Name -&gt; Value -&gt; Description (Fallback-=
Kaskade)
String Function Web_LabelFromCurrent()
	var string name, string val, string desc
	name =3D default.GetObjectName()
	If !default.StringIsBlank(name) Then
		Return name
	EndIf
	val =3D default.GetObjectValue()
	If !default.StringIsBlank(val) Then
		Return val
	EndIf
	desc =3D default.GetObjectDescription()
	If !default.StringIsBlank(desc) Then
		Return desc
	EndIf
	Return "(ohne Name)"
EndFunction

; Liefert eine einfache Positionssignatur des aktuellen Objekts (zur Abbruc=
herkennung)
String Function Web_CurrentRectKey()
	var int l, int r, int t, int b
	var string s
	l =3D 0
	r =3D 0
	t =3D 0
	b =3D 0
	default.GetObjectRect(l, r, t, b)
	s =3D default.IntToString(l) + "," + default.IntToString(t) + "," + defaul=
t.IntToString(r) + "," + default.IntToString(b)
	Return s
EndFunction

; Sammelt Objekte einer QuickNav-Kategorie in eine Delimiter-Liste.
; Achtung: F=C3=BCr QN_LISTITEM existiert kein "MoveToFirstListItem".
;&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; In diesem Fall wird mit einem initialen=
 MoveToNext* begonnen.
String Function Web_ListByQuickNav(Int what, String sDelimiter, Int maxCoun=
t)
	var string list, string keyPrev, string keyNow, string label
	var int count

	list =3D cscNull
	keyPrev =3D cscNull
	keyNow&nbsp; =3D cscNull
	label&nbsp; &nbsp;=3D cscNull
	count&nbsp; &nbsp;=3D 0

	; Start auf erstes Element (falls verf=C3=BCgbar)
	If what !=3D QN_LISTITEM Then
		self.Web_QN_MoveToFirst(what)
	Else
		; F=C3=BCr ListItem gibt es nur Next =E2=80=93 direkt ins erste Next
		self.Web_QN_MoveToNext(what)
	EndIf

	; Erste Position aufnehmen
	keyPrev =3D self.Web_CurrentRectKey()

	; Sammeln
	While count &lt; maxCount
		label =3D self.Web_LabelFromCurrent()
		If !default.StringIsBlank(label) Then
			self.Web_List_Append (list, label, sDelimiter)
			count =3D count + 1
		EndIf

		; Weiter
		self.Web_QN_MoveToNext(what)
		keyNow =3D self.Web_CurrentRectKey()

		; Abbruchbedingung: keine Bewegung mehr
		If keyNow =3D=3D keyPrev Then
			Break loop
		EndIf

		keyPrev =3D keyNow
	EndWhile

	Return list
EndFunction

