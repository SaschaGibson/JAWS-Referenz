; F=C3=BCgt eine Zeile mit Code zum UserBuffer hinzu, sauber einger=C3=BCck=
t.
Void Function Assistant_AddCodeLine (string sCode)
    UserBufferAddText ("    " + sCode + cScBufferNewLine)
EndFunction

; Extrahiert den Wert eines bestimmten Attributs aus einem XML-String.
string Function Assistant_ExtractXMLAttribute (string xml, string attribute=
Name)
	var int startPos, endPos
	var string tempString, result
=09
	startPos =3D StringContains(xml, attributeName + "=3D\"")
	if startPos &gt; 0 then
		tempString =3D Substring(xml, startPos + StringLength(attributeName) + 2,=
 StringLength(xml))
		endPos =3D StringContains(tempString, "\"")
		if endPos &gt; 1 then
			result =3D Substring(tempString, 1, endPos - 1)
		endif
	endif
	return result
EndFunction

