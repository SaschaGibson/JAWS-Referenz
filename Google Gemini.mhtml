; Stellt geb=C3=BCndelte DOM/UIA-Informationen =C3=BCber das aktuell fokuss=
ierte Webelement bereit.
; -------------------------------------------------------------------------=
----
; Skriptsprache: Englisch | Kommentare: Deutsch
; Ansatz: Korrekte UIA-Initialisierung mit CreateObjectEx und Manifest.
; Ausgabe: Virtual Viewer (UserBuffer)
; -------------------------------------------------------------------------=
----
; Version: 4.1.0 (2025-09-18) - oUIA als int-Handle deklariert
; Autor:   Projekt "JAWS: Webelemente"

Include "HjGlobal.jsh"
Include "HjConst.jsh"
Include "common.jsm"
Use "UIA.jsb"

ScriptFileVersion 2025
ScriptFile "Werkzeug zur Inspektion von Webelementen (UIA-Modus)"

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
