; Sammelt alle Informationen und generiert Code-Vorschl=C3=A4ge.
Script InspectAndAssist ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var string msaaName, msaaValue, msaaRoleText, msaaStateText, msaaDesc
	var int    msaaRoleCode
	var string elementXml
	var string htmlDescription
	var string fsIdHex
	var int    fsIdDec
	var string tagName
	var string elementName
	var string elementText

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---

	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf

	; --- Schritt A: Alle Daten sammeln ---
	msaaName =3D GetObjectName()
	msaaValue =3D GetObjectValue()
	msaaDesc =3D GetObjectDescription()
	msaaRoleCode =3D GetObjectRole()
	msaaRoleText =3D GetRoleText(msaaRoleCode)
	msaaStateText =3D GetObjectState()
	elementXml =3D GetElementXML (0)
	htmlDescription =3D GetElementDescription(0, 0)

	; --- Schritt B: fsID und andere Attribute aus XML extrahieren ---
	if !StringIsBlank(elementXml) then
		fsIdHex =3D Inspector_ExtractXMLAttribute(elementXml, "fsID")
		if !StringIsBlank(fsIdHex) then
			fsIdDec =3D HexToDec(fsIdHex)
		endif
		tagName =3D Inspector_ExtractXMLAttribute(elementXml, "fsTag")
		elementName =3D Inspector_ExtractXMLAttribute(elementXml, "name")
		elementText =3D Inspector_ExtractXMLAttribute(elementXml, "fsText")
	endif

	; --- Ausgabe vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("BETA Inspector &amp; Assistent")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)

	; Abschnitt 1: Code-Vorschl=C3=A4ge
	UserBufferAddText ("1. Code-Vorschl=C3=A4ge" + cScBufferNewLine)
	if fsIdDec !=3D 0 then
		Inspector_AddCodeLine ("; -- Aktion =C3=BCber fsID (stabilste Methode) --=
")
		Inspector_AddCodeLine ("PerformActionOnElementWithID (" + IntToString(fsI=
dDec) + ", Action_setFocus)")
		Inspector_AddCodeLine ("PerformActionOnElementWithID (" + IntToString(fsI=
dDec) + ", Action_doDefaultAction)")
	else
		UserBufferAddText ("(Keine fsID gefunden, keine prim=C3=A4ren Vorschl=C3=
=A4ge verf=C3=BCgbar.)")
	endif

	if !StringIsBlank(elementName) then
		UserBufferAddText (cScBufferNewLine)
		Inspector_AddCodeLine ("; -- Alternative =C3=BCber 'name'-Attribut --")
		Inspector_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Action=
_setFocus, \"" + tagName + "\", \"name\", \"" + elementName + "\", 1)")
	endif
=09
	if !StringIsBlank(elementText) then
		UserBufferAddText (cScBufferNewLine)
		Inspector_AddCodeLine ("; -- Alternative =C3=BCber sichtbaren Text --")
		Inspector_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Action=
_setFocus, \"" + tagName + "\", \"fsText\", \"" + elementText + "\", 1)")
	endif
=09
	; Abschnitt 2: MSAA-Eigenschaften
	UserBufferAddText (cScBufferNewLine + "-----------------------------------=
-----" + cScBufferNewLine)
	UserBufferAddText ("2. MSAA-Eigenschaften" + cScBufferNewLine)
	Inspector_AddInfo("Name", msaaName)
	Inspector_AddInfo("Rolle", msaaRoleText)
	Inspector_AddInfo("Status", msaaStateText)

	; Abschnitt 3: HTML-Elementbeschreibung
	UserBufferAddText (cScBufferNewLine + "-----------------------------------=
-----" + cScBufferNewLine)
	UserBufferAddText ("3. HTML-Elementbeschreibung (via GetElementDescription=
)" + cScBufferNewLine)
	if !StringIsBlank(htmlDescription) then
		UserBufferAddText(htmlDescription)
	else
		UserBufferAddText ("(Keine HTML-Beschreibung verf=C3=BCgbar.)")
	endif
=09
	; Abschnitt 4: Rohes XML
	UserBufferAddText (cScBufferNewLine + "-----------------------------------=
-----" + cScBufferNewLine)
	UserBufferAddText ("4. XML-Details (via GetElementXML)" + cScBufferNewLine=
)
	if !StringIsBlank(elementXml) then
		UserBufferAddText (elementXml)
	else
		UserBufferAddText ("(Keine XML-Informationen verf=C3=BCgbar.)")
	endif

	; --- Viewer aktivieren ---
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)
	UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	UserBufferActivate ()
	JAWSTopOfFile ()
	SayLine ()
EndScript
