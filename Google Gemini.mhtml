; Holt das aktuelle Dokument als DOM-Objekt + Roh-XML (optional)
Object Function WebXml_GetDocument(Optional Bool bUnrestricted, Optional St=
ring ByRef xmlOut)
	var object xmlDoc
	var string xml
	xml =3D cscNull
	If bUnrestricted Then
		xmlDoc =3D default.GetFSXMLDomDocUnrestricted (xml)
	Else
		xmlDoc =3D default.GetFSXMLDomDoc (xml)
	EndIf
	If !xmlDoc Then
		xmlOut =3D cscNull
		Return default.Null()
	EndIf
	xmlOut =3D xml
	Return xmlDoc
EndFunction

; F=C3=BCgt einen Eintrag sItem an sList an =E2=80=93 mit Delimiter, wenn s=
List nicht leer ist
Void Function Web_List_Append(String ByRef sList, String sItem, String sDel=
imiter)
	If default.StringIsBlank (sItem) Then
		Return
	EndIf
	If !default.StringIsBlank (sList) Then
		sList =3D sList + sDelimiter
	EndIf
	sList =3D sList + sItem
EndFunction

; Erzeugt Label aus gew=C3=BCnschten Attributen (CSV). Fallback: sichtbarer=
 Text, dann id.
String Function Web_Node_LabelFromAttrs(Object node, String sAttrCsv)
	If !node Then
		Return cscNull
	EndIf

	var object attribs
	var object itm
	var string result, string attr, string txt
	var int count, int i

	attribs =3D node.attributes
	result&nbsp; =3D cscNull
	count&nbsp; &nbsp;=3D default.StringSegmentCount (sAttrCsv, ",")

	For i =3D 1 To count
		attr =3D default.StringLower (default.StringTrimLeadingBlanks (default.St=
ringTrimTrailingBlanks (default.StringSegment (sAttrCsv, ",", i))))
		If !default.StringIsBlank (attr) Then
			itm =3D attribs.GetNamedItem (attr)
			If itm &amp;&amp; itm.nodeValue Then
				self.Web_List_Append (result, itm.nodeValue, " =E2=80=94 ")
			EndIf
		EndIf
	EndFor

	If default.StringIsBlank (result) Then
		txt =3D default.GetXMLDomNodeText (node)
		If !default.StringIsBlank (txt) Then
			result =3D txt
		Else
			itm =3D attribs.GetNamedItem("id")
			If itm &amp;&amp; itm.nodeValue Then
				result =3D itm.nodeValue
			Else
				result =3D cscNull
			EndIf
		EndIf
	EndIf

	Return result
EndFunction

; Pr=C3=BCft, ob ein Knoten den gew=C3=BCnschten Tag hat (case-insensitive)=
. Leerer Tag oder "*" matcht alles.
Int Function Web_Node_MatchesTag(Object node, String sWantTag)
	If default.StringIsBlank (sWantTag) Then
		Return True
	EndIf
	If sWantTag =3D=3D "*" Then
		Return True
	EndIf

	var string want, string have
	want =3D default.StringLower (sWantTag)
	have =3D default.StringLower (node.nodeName)

	Return (have =3D=3D want)
EndFunction

; Rekursive Sammlung passender Knoten in eine Delimiter-Liste
Void Function Web_Dom_CollectByTag(Object node, String sTag, String sAttrCs=
v, String sDelimiter, String ByRef sOutList)
	If !node Then
		Return
	EndIf

	If self.Web_Node_MatchesTag (node, sTag) Then
		var string label
		label =3D self.Web_Node_LabelFromAttrs (node, sAttrCsv)
		If !default.StringIsBlank (label) Then
			self.Web_List_Append (sOutList, label, sDelimiter)
		EndIf
	EndIf

	; Kinder besuchen
	var object kids
	var object n
	kids =3D node.childNodes
	forEach n in kids
		self.Web_Dom_CollectByTag (n, sTag, sAttrCsv, sDelimiter, sOutList)
	endForEach
EndFunction

