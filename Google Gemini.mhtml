; -------------------------------------------------------------------------=
----
; WebViewer_ShowText
; Zeigt Titel+Text im Virtual Viewer (UserBuffer) an und liest die erste Ze=
ile.
; -------------------------------------------------------------------------=
----
Void Function WebViewer_ShowText(String sTitle, String sBody)
	default.UserBufferClear ()
	If !default.StringIsBlank (sTitle) Then
		default.UserBufferAddText (sTitle)
		default.UserBufferAddText (cScBufferNewLine)
	EndIf
	If !default.StringIsBlank (sBody) Then
		default.UserBufferAddText (sBody)
	EndIf
	default.UserBufferAddText (cScBufferNewLine)
	; Schlie=C3=9Fen-Link nach JAWS-Standard erg=C3=A4nzen
	default.UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	default.UserBufferActivate ()
	default.JAWSTopOfFile ()
	default.SayLine ()
EndFunction

