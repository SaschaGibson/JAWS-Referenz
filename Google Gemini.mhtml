 _ngcontent-ng-c2340253945=3D"" role=3D"text" data-test-id=3D"code-content"=
 class=3D"code-container formatted ng-tns-c2340253945-56">; KOS_mobil.jss
; Skripte zur verbesserten Zug=C3=A4nglichkeit der KOSmobil-Anwendung,
; insbesondere zur Umgehung von aria-hidden=3D"true".
; -------------------------------------------------------------------------=
----
; Skriptsprache: Englisch | Kommentare: Deutsch
; Ansatz: UI Automation (UIA) mit TreeWalker, um alle Elemente zu erfassen.
; Ausgabe: Virtual Viewer (UserBuffer)
; -------------------------------------------------------------------------=
----
; Version: 1.2.0 (2025-09-25) - Korrektur der String-Erstellung f=C3=BCr Ei=
nr=C3=BCckung
; Autor:   Projekt "JAWS: Webelemente"

Include "HjGlobal.jsh"
Include "HjConst.jsh"
Include "common.jsm"
Use "UIA.jsb"

ScriptFileVersion 2025
ScriptFile "KOSmobil Anpassungen"

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Interne Hilfsfunktionen
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; Rekursive Funktion, die den UIA-Baum durchl=C3=A4uft und Elemente sammelt=
.
Void Function WalkUIATree (object walker, object element, int level, string=
 sDelimiter, string ByRef out_list)
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var string indent
	var string currentLine
	var object child
	var int i

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---
=09
	; Endlosschleife verhindern
	if level &gt; 50 then
		return
	endif

	; Aktuelles Element zur Liste hinzuf=C3=BCgen
	; Erstellt die Einr=C3=BCckung durch eine Schleife (robuste Methode)
	indent =3D ""
	For i =3D 1 to level * 2
		indent =3D indent + " "
	EndFor
=09
	currentLine =3D indent + element.ControlType + ": " + element.Name
	out_list =3D out_list + currentLine + sDelimiter

	; Erstes Kind-Element holen und die Funktion f=C3=BCr dieses aufrufen
	child =3D walker.GetFirstChildElement(element)
	while child
		; Rekursiver Aufruf f=C3=BCr das Kind
		WalkUIATree(walker, child, level + 1, sDelimiter, out_list)
		; N=C3=A4chstes Geschwister-Element holen
		child =3D walker.GetNextSiblingElement(child)
	endwhile
EndFunction


; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Hauptskript
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; Listet alle UIA-Elemente des aktuellen Dokuments auf, auch die mit aria-h=
idden=3D"true".
Script ListAllUIADocElements ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var object oUIA
	var object rootElement
	var object walker
	var string elementList
	var string sDelimiter

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---
=09
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf
=09
	oUIA =3D CreateObjectEx ("FreedomSci.UIA", false, "UIAScriptAPI.x.manifest=
")
	if !oUIA then
		Say("Konnte das UIA-Objekt nicht erstellen.", OT_ERROR)
		return
	endif
=09
	; Das Wurzelelement des aktuellen Dokuments holen
	rootElement =3D FSUIAGetDocumentElement(oUIA)
	if !rootElement then
		Say("Konnte das UIA-Wurzelelement des Dokuments nicht finden.", OT_ERROR)
		return
	endif

	; --- Den UIA-Baum durchlaufen ---
	walker =3D oUIA.CreateTreeWalker()
	if walker then
		sDelimiter =3D "|"
		elementList =3D ""
		WalkUIATree(walker, rootElement, 0, sDelimiter, elementList)
	endif

	; --- Ausgabe vorbereiten und anzeigen ---
	if !StringIsBlank(elementList) then
		UserBufferClear()
		UserBufferAddText ("Vollst=C3=A4ndige UIA-Elementliste (inkl. aria-hidden=
)")
		UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)
	=09
		; Die Liste f=C3=BCr die Anzeige aufbereiten (Pipe durch Zeilenumbruch er=
setzen)
		UserBufferAddText(StringReplaceSubstrings(elementList, sDelimiter, cScBuf=
ferNewLine))

		UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)
		UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
		UserBufferActivate ()
		JAWSTopOfFile ()
		SayLine ()
	else
		Say("Konnte keine UIA-Elemente zum Auflisten finden.", OT_ERROR)
	endif
EndScript
