; Version: 1.4.0 (2025-09-09)
; Autor:   Projekt "JAWS: Webelemente"

Include "HjGlobal.jsh"
Include "HjConst.jsh"
Include "common.jsm"

ScriptFileVersion 2025
ScriptFile "Werkzeug zur Inspektion von Webelementen"

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Interne Hilfsfunktionen
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; F=C3=BCgt eine Zeile mit Titel und Wert zum UserBuffer hinzu, wenn der We=
rt nicht leer ist.
Void Function Inspector_AddInfo (string sTitle, string sValue)
    if !StringIsBlank(sValue) then
        UserBufferAddText ("- " + sTitle + ": " + sValue + cScBufferNewLine=
)
    endIf
EndFunction

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Hauptskript
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; Sammelt diverse technische Informationen zum Element unter dem virtuellen=
 Cursor
; und zeigt diese im Virtual Viewer an.
Script Web_InspectCurrentElement ()
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf

	; --- Variablen deklarieren (angepasst an die Komma-Regel) ---
	var object domNode, object attributes, object attr,
        string nodeText, string nodeXML,
        string msaaName, string msaaValue, string msaaRole, string msaaStat=
e, string msaaDesc,
        int i, int attrCount

	; --- 1. DATEN SAMMELN: DOM-Informationen ---
	domNode =3D GetXMLDomNodeFromVirtualCursor()

	if !domNode then
		Say("Kein DOM-Knoten unter dem virtuellen Cursor gefunden.", OT_ERROR)
		return
	endIf

	nodeText =3D GetXMLDomNodeText(domNode)
	attributes =3D domNode.attributes
	attrCount =3D attributes.length
	nodeXML =3D domNode.xml

	; --- 2. DATEN SAMMELN: MSAA-Informationen ---
	msaaName =3D GetObjectName()
	msaaValue =3D GetObjectValue()
	msaaRole =3D GetObjectRole(ROLE_SYSTEM_CLIENT, 1)
	msaaState =3D GetObjectState(STATE_SYSTEM_NORMAL, 1)
	msaaDesc =3D GetObjectDescription()

	; --- 3. AUSGABE VORBEREITEN UND ANZEIGEN ---
	UserBufferClear()
	UserBufferAddText ("Web Element Inspector")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cScBuffe=
rNewLine)

	; Abschnitt 1: Allgemeine Infos
	UserBufferAddText ("1. Allgemeine Infos" + cScBufferNewLine)
	Inspector_AddInfo("Tag-Name", domNode.nodeName)
	Inspector_AddInfo("Sichtbarer Text", nodeText)
	UserBufferAddText (cScBufferNewLine)

	; Abschnitt 2: MSAA-Eigenschaften
	UserBufferAddText ("2. MSAA-Eigenschaften" + cScBufferNewLine)
	Inspector_AddInfo("Name", msaaName)
	Inspector_AddInfo("Wert", msaaValue)
	Inspector_AddInfo("Rolle", msaaRole)
	Inspector_AddInfo("Status", msaaState)
	Inspector_AddInfo("Beschreibung", msaaDesc)
	UserBufferAddText (cScBufferNewLine)

	; Abschnitt 3: Alle HTML/ARIA Attribute durchlaufen und ausgeben
	UserBufferAddText ("3. HTML/ARIA Attribute (" + IntToString(attrCount) + "=
)" + cScBufferNewLine)
	if attrCount &gt; 0 then
		For i =3D 0 to attrCount - 1
			attr =3D attributes.item(i)
			if attr then
				Inspector_AddInfo(attr.nodeName, "'" + attr.nodeValue + "'")
			endIf
		EndFor
	else
		UserBufferAddText("- (keine)" + cScBufferNewLine)
	endIf
	UserBufferAddText (cScBufferNewLine)

	; Abschnitt 4: Kompletter XML-Code des Knotens
	UserBufferAddText ("4. DOM-Knoten (XML-Ausschnitt)" + cScBufferNewLine)
	UserBufferAddText (nodeXML)
	UserBufferAddText (cScBufferNewLine)

	; --- Viewer aktivieren und Fokus setzen ---
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cScBuffe=
rNewLine)
	UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	UserBufferActivate ()
	JAWSTopOfFile ()
	SayLine ()

EndScript
