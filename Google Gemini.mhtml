; Sammelt diverse technische Informationen zum Element unter dem virtuellen=
 Cursor
; und zeigt diese im Virtual Viewer an.
Script Web_InspectCurrentElement ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var int domNodeHandle
	var object domNode
	var object attributes
	var object attr
	var string nodeInfoString
	var string nodeType
	var string nodeText
	var string nodeXML
	var string msaaName
	var string msaaValue
	var string msaaRole
	var string msaaState
	var string msaaDesc
	var int i
	var int attrCount

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---

	; Sicherheitspr=C3=BCfung: Nur im virtuellen Modus ausf=C3=BChren
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf

	; --- Schritt A: Handle (als Integer) holen ---
	domNodeHandle =3D GetXMLDomNodeFromVirtualCursor()
	if domNodeHandle =3D=3D 0 then
		Say("Schritt A fehlgeschlagen: Kein Handle vom virtuellen Cursor erhalten=
.", OT_ERROR)
		return
	endif

	; --- Schritt B: Handle in ein benutzbares Objekt umwandeln ---
	domNode =3D DOMNodeFromHandle(domNodeHandle)
	if !domNode then
		Say("Schritt B fehlgeschlagen: Konnte Handle nicht in ein Objekt umwandel=
n.", OT_ERROR)
		return
	endif

	; --- Daten sammeln: DOM-Informationen via Objekt ---
	nodeInfoString =3D GetXMLDomNodeTypeAndText(domNode)
	nodeType =3D StringSegment(nodeInfoString, crlf, 1)
	nodeText =3D StringSegment(nodeInfoString, crlf, 2)
	nodeXML =3D GetElementXML(domNode)
	attributes =3D domNode.attributes
	attrCount =3D attributes.length

	; --- Daten sammeln: MSAA-Informationen ---
	msaaName =3D GetObjectName()
	msaaValue =3D GetObjectValue()
	msaaRole =3D GetObjectRole(ROLE_SYSTEM_CLIENT, 1)
	msaaState =3D GetObjectState(STATE_SYSTEM_NORMAL, 1)
	msaaDesc =3D GetObjectDescription()

	; --- Ausgabe im Virtual Viewer vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("Web Element Inspector")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D" + cScBuffe=
rNewLine)

	; Abschnitt 1: Allgemeine Infos
