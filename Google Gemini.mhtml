; Liefert Delimiter-Liste passender Elemente (per Tag + Attribute in CSV)
String Function GetListOfTags(String sTag, String sAttrCsv, String sDelimit=
er)
	var string xml, string list
	var object doc, object root

	xml&nbsp; =3D cscNull
	list =3D cscNull

	doc&nbsp; =3D self.WebXml_GetDocument (False, xml)
	If !doc Then
		Return cscNull
	EndIf

	root =3D doc.SelectSingleNode ("/*")
	self.Web_Dom_CollectByTag (root, sTag, sAttrCsv, sDelimiter, list)
	Return list
EndFunction

