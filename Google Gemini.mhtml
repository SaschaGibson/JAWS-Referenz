; Erstellt eine strukturelle Zusammenfassung der aktuellen Webseite
; unter Verwendung der dedizierten und verifizierten HTML-Funktionen von JA=
WS.
; -------------------------------------------------------------------------=
----
; Skriptsprache: Englisch | Kommentare: Deutsch
; Ansatz: Gezielter Aufruf von verifizierten Get...Count Funktionen.
; Ausgabe: Virtual Viewer (UserBuffer)
; -------------------------------------------------------------------------=
----
; Version: 2.0.0 (2025-09-28) - Nur verifizierte Funktionen
; Autor:   Projekt "JAWS: Webelemente"

Include "HjGlobal.jsh"
Include "HjConst.jsh"
Include "common.jsm"

ScriptFileVersion 2025
ScriptFile "HTML Seiten-Zusammenfassung (verifiziert)"

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Interne Hilfsfunktionen
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; F=C3=BCgt eine Zeile mit einer Z=C3=A4hlung zum UserBuffer hinzu.
Void Function Summary_AddCount (string sLabel, int iCount)
    if iCount &gt;=3D 0 then
        UserBufferAddText ("- " + sLabel + ": " + IntToString(iCount) + cSc=
BufferNewLine)
    endif
EndFunction

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Hauptskript
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; Sammelt diverse Z=C3=A4hlungen von HTML-Elementen und zeigt sie an.
Script GeneratePageSummary ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var int i

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---
=09
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf
=09
	; --- Ausgabe vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("HTML Seiten-Zusammenfassung")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)

	; --- Z=C3=A4hlungen durchf=C3=BChren und ausgeben (nur verifizierte Funkt=
ionen) ---
=09
	; =C3=9Cberschriften
	UserBufferAddText ("=C3=9Cberschriften:" + cScBufferNewLine)
	Summary_AddCount("Alle =C3=9Cberschriften", GetHeadingCount(0))
	For i =3D 1 to 6
		Summary_AddCount("Ebene " + IntToString(i), GetHeadingCount(i))
	EndFor
	UserBufferAddText (cScBufferNewLine)

	; Strukturelle Elemente
	UserBufferAddText ("Strukturelle Elemente:" + cScBufferNewLine)
	Summary_AddCount("Links insgesamt", GetLinkCount())
	Summary_AddCount("Tabellen", GetTableCount())
	Summary_AddCount("Grafiken", GetGraphicCount())
	Summary_AddCount("Frames", GetHTMLFrameCount())

	; --- Viewer aktivieren ---
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)
	UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	UserBufferActivate ()
	JAWSTopOfFile ()
	SayLine ()

EndScript
