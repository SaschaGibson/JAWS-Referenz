; Generiert fertige Code-Schnipsel f=C3=BCr Aktionen auf dem aktuell fokuss=
ierten Element.
; -------------------------------------------------------------------------=
----
; Skriptsprache: Englisch | Kommentare: Deutsch
; Ansatz: Reiner UIA-Ansatz mit Element-Erfassung per Bildschirmkoordinaten=
.
; Ausgabe: Virtual Viewer (UserBuffer)
; -------------------------------------------------------------------------=
----
; Version: 3.1.0 (2025-09-23) - Korrektur auf GetCursorRect
; Autor:   Projekt "JAWS: Webelemente"

Include "HjGlobal.jsh"
Include "HjConst.jsh"
Include "common.jsm"
Use "UIA.jsb"

ScriptFileVersion 2025
ScriptFile "JAWS Script-Assistent"

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Interne Hilfsfunktionen
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; F=C3=BCgt eine Zeile mit Code zum UserBuffer hinzu, sauber einger=C3=BCck=
t.
Void Function Assistant_AddCodeLine (string sCode)
    UserBufferAddText ("    " + sCode + cScBufferNewLine)
EndFunction

; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
; Hauptskript
; =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

; Analysiert das aktuelle Element und generiert passende Code-Beispiele.
Script GenerateElementAction ()
	; --- 1. ZUERST: Alle Variablen deklarieren ---
	var object oUIA
	var object oElement
	var object xmlDoc
	var object xmlNode
	var string elementXml
	var string fsIdHex
	var int    fsIdDec
	var int    left, int top, int right, int bottom
	var int    x, int y

	; --- 2. DANACH: Ausf=C3=BChrbarer Code ---
=09
	if !IsVirtualPCCursor() then
		SayFormattedMessage(OT_ERROR, cmsgFeatureRequiresVirtualCursor_L, cmsgFea=
tureRequiresVirtualCursor_S)
		return
	endIf
=09
	oUIA =3D CreateObjectEx ("FreedomSci.UIA", false, "UIAScriptAPI.x.manifest=
")
	if !oUIA then
		Say("Konnte das UIA-Objekt nicht erstellen.", OT_ERROR)
		return
	endif
=09
	; --- Schritt B: Element-Erfassung per Koordinate (reiner UIA-Weg) ---
	; Wir holen das Rechteck des virtuellen Cursors (Typ 2)
	GetCursorRect(left, top, right, bottom, 2)
	; Wir berechnen den Mittelpunkt des Rechtecks
	x =3D (left + right) / 2
	y =3D (top + bottom) / 2
=09
	oElement =3D oUIA.ElementFromPoint (x, y)

	if !oElement then
		Say("Konnte kein UIA-Element an der Cursor-Position finden.", OT_ERROR)
		return
	endif

	; --- Schritt C: fsID extrahieren ---
	elementXml =3D oElement.GetXML()
=09
	if !StringIsBlank(elementXml) then
		xmlDoc =3D CreateObject("msxml2.DOMDocument.6.0")
		if xmlDoc then
			xmlDoc.loadXML(elementXml)
			xmlNode =3D xmlDoc.documentElement
			if xmlNode then
				fsIdHex =3D xmlNode.getAttribute("fsID")
				if !StringIsBlank(fsIdHex) then
					fsIdDec =3D HexToDec(fsIdHex)
				endif
			endif
		endif
	endif

	; --- Ausgabe vorbereiten ---
	UserBufferClear()
	UserBufferAddText ("Script-Assistent: Code-Vorschl=C3=A4ge")
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)

	; --- Logik zur Code-Generierung (mit korrekter Parameter-Reihenfolge) ---
	if fsIdDec &gt; 0 then
		UserBufferAddText ("Priorit=C3=A4t 1: Aktion =C3=BCber fsID (stabilste Me=
thode f=C3=BCr diese Sitzung)" + cScBufferNewLine)
		Assistant_AddCodeLine ("; HINWEIS: Die fsID (" + fsIdHex + ") ist dynamis=
ch und nur f=C3=BCr die aktuelle Seitenladung g=C3=BCltig!")
		Assistant_AddCodeLine ("; Element mit der fsID " + IntToString(fsIdDec) +=
 " fokussieren:")
		Assistant_AddCodeLine ("PerformActionOnElementWithID (" + IntToString(fsI=
dDec) + ", Action_setFocus)")
		UserBufferAddText (cScBufferNewLine)
		Assistant_AddCodeLine ("; Standard-Aktion f=C3=BCr fsID " + IntToString(f=
sIdDec) + " ausf=C3=BChren (z.B. Klick):")
		Assistant_AddCodeLine ("PerformActionOnElementWithID (" + IntToString(fsI=
dDec) + ", Action_doDefaultAction)")
	else
		UserBufferAddText ("Konnte keine dynamische fsID f=C3=BCr dieses Element =
finden.")
		UserBufferAddText (cScBufferNewLine)
		UserBufferAddText ("Alternative Vorschl=C3=A4ge (weniger stabil):" + cScB=
ufferNewLine)
	=09
		var string automationId, string elementName
		automationId =3D oElement.AutomationId
		elementName =3D oElement.Name

		if !StringIsBlank(automationId) then
			UserBufferAddText (cScBufferNewLine + "Vorschlag A: Aktion =C3=BCber Aut=
omationID" + cScBufferNewLine)
			Assistant_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Actio=
n_setFocus, \"*\", \"AutomationId\", \"" + automationId + "\", 1)")
			Assistant_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Actio=
n_doDefaultAction, \"*\", \"AutomationId\", \"" + automationId + "\", 1)")
		endif

		if !StringIsBlank(elementName) then
			UserBufferAddText (cScBufferNewLine + "Vorschlag B: Aktion =C3=BCber Nam=
e" + cScBufferNewLine)
			Assistant_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Actio=
n_setFocus, \"*\", \"Name\", \"" + elementName + "\", 1)")
			Assistant_AddCodeLine ("PerformActionOnElementWithTagAndAttribute (Actio=
n_doDefaultAction, \"*\", \"Name\", \"" + elementName + "\", 1)")
		endif
	endif

	; --- Viewer aktivieren ---
	UserBufferAddText (cScBufferNewLine + "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D" + cScBufferNewLine)
	UserBufferAddText (cmsgClose, "UserBufferDeactivate()", cmsgClose)
	UserBufferActivate ()
	JAWSTopOfFile ()
	SayLine ()

EndScript
