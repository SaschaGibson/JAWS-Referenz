;  Copyright 1995-2021 Freedom Scientific, Inc.
;  JAWS configuration file for Outlook 2016 and later

[RichEdit and Edit Control Options]
UseOSM=0
AppendShapeDimensions=0
; See selCtx* flags in hjconst.jsh 
; See selCtx* flags in hjconst.jsh.  It is written here as a hex value.
; but in Office365 and later, the values are in decimal unlike HjConst.jsh.
;SelectionContextFlags=ea389c
SelectionContextFlags=15349916

[WindowClasses]
;for Office popup dialogs - such as 'Rights Management'
NUIDialog=Dialog
REComboBox20W=EditCombo
SUPERGRID=ListBox
OutlookGrid=ListBox
RichEdit20A=Edit
MSOUNISTAT=Static
WMSUIVLB=ListBox
OpenListView=ListView
Internet Explorer_TridentCmboBx=ComboBox
MSOBALLOON=Dialog
RichEdit20W=Edit
RichEdit20WPT=Edit
OUTEXVLB=ListBox
_WwN=MultilineEdit

[OSM]
;0 off, 1 underline spelling errors, 2 underline grammatical errors, 
;4 underline revisions, 8 underline commented text, 16 underline footnote and endnote references, 
;Note this is a bit mask. Set all bits to on to underline all types of proofreading elements.
;defaults to underlining spelling errors, revisions, commented text and footnote/endnote references.
UnderlineProofreadingErrors=29
;0 off, 1 underline spelling errors, 2 underline grammatical errors, 3 underline both.
;defaults to off.
UnderlineProofreadingErrors=0
VirtualCursorEnhancedClipboard=2
UseVirtualPCCursorInWebDialogs=0
TrackFocusRect=1
EditPromptSearch=2
IncludeGraphics=1 ;replacing picture and object detection for document window in Outlook 2007
UseCustomHighlight=1
CustomHighlightTextColor=255255255
CustomHighlightColor=000000000
CaretSearch=254
GraphicMinX=9
GraphicMinY=9
;  Textout must be 0 to solve Track Defect 10094, When replying to HTML messages the screen is
;  continuously being redrawn causing Braille not to update
TextOutDelay=0

[Braille]
InjectBrailleKeysAsUnicodeChars=1
;OSM is not available in Word 2013:
UseOSM=0
SimulateSpatialLayoutWhenNoOSM=1
;0 off, distinguish each bullet type, 1 treat all bullets the same
GeneralizeBullets=0
;  highlight + underline + color + script
BrailleShowMarking=456
;  visited and unvisited links
;  as well as selected links
;  BrailleMarkColors=128000128/255255255,000000255/255255255,255255153/000000000,192192192/000000000,051102255/255255255

[MSAAClasses]
SysListView32=0
bosa_sdm_Mso96=1
REListBox20W=1

[options]
; grammar and advanced proofing is now on for default, to assist with browsers, but off by default for Word and Outlook.
GrammarAttributeOverride=0|messageVoice||messageVoice|
;Whether to use legacy SDM API in Office apps. Override in Office 365 jcf.
useSDMAPI=0
LanguageDetection=0
;New Virtual cursor support for readonly messages
;1 use virtual, 0 use enhanced (like prior versions)
UseVPCInsteadOfEnhancedEditModeForReadOnlyDocs=1
;determines whether the TopEdgeEvent and BottomEdgeEvent will fire, 1=true, 0=false
TopAndBottomEdgeAlert=1
;0 always generalize, that is, treat nonbreaking space as space, nonbreaking hyphen as hyphen all the time.
;1 indicate nonbreaking symbols when reading by character, otherwise do not distinguish them
;2 also indicate when reading by word
;3 also indicate when reading by line, sentence, paragraph, chunk etc,
;4 also indicate during a sayAll
IndicateNonbreakingSymbols=0
;0 off, distinguish each bullet type, 1 treat all bullets the same and just announce as bullet.
GeneralizeBullets=0
QuickKeyNavigationMode=1
SayAllMode=1 ; as in Word.
;TreeViewCheckBoxes=0
;UseCustomHighlight=1

[HTML]
HeadingIndication=2
DocumentPresentationMode=0
SkipPastRepeatedText=0
AnnounceLiveRegionUpdates=1
;0=keep JAWS added blank lines in the virtual buffer; 1=remove JAWS added blank lines in the virtual buffer
TurnOffBlankLineRendering=0


[NonJCFOptions]
; sounds for when autocomplete list appears and disappears,
; for message header fields when entering contacts.
AutoCompleteListEnterSound=OutlookAutocompleteEnterSound.wav
AutoCompleteListExitSound=OutlookAutocompleteExitSound.wav
; Whether or not to play Autocomplete sounds,
; corresponds to QuickSettings PlaySoundsForAutocomplete checkbox 
AutoCompletePlaySounds=1
; GroupChange is usually date or conversation name.
; Name usually starts with "Group by: " 
; 0 = ignore (standard JAWS behavior),
; 1 = announce on change (Narrator and NVDA bbehavior)
AnnounceGroupChangeInLists=0
; determine if JAWS reads list items using customization or straight from UIA
; 1 = classic functionality, 0 = read using UIA like Narrator and NVDA.
UseJAWSCustomization=1
AutoCompleteVerbosity=1
RepliedVerbosity=1
ForwardedVerbosity=1
UnreadVerbosity=1
; set to 0 to comply with other products and eexpected Office365 behavoirs, can enable in QuickSettings:
MessageHeaderVerbosity=0
MessageTitleVerbosity=1
MessageElementsVerbosity=1
; set to 1 to comply with other products and eexpected Office365 behavoirs, can enable in QuickSettings:
MessageSayAllVerbosity=1
MessageLinkCountIndication=0
InformationBarVerbosity=1
CalendarHighlightColor=6956042
;From Word, for messages. Now works in Outlook 365
DetectAutoCorrect=0
DetectSpelling=0
DetectGrammar=0
SchemeDocSpecific=0
dockToolbars=1
NamedTitles=0
TableDescription=1
DetectRevisions=1
DetectSpelling=0
DetectGrammar=0
FormFieldHelp=1
TabMeasurementIndication=1
styleChanges=0
LineSpacingDetection=0
AnnounceCellCoordinates=1
DetectBookmarks=0
DetectObjectCount=1
DisplayBRLTableNumber=1
IncludeBlankParagraphsForParagraphNavigation=0
; for size of document where we generate an error.
; documents bigger than this cause crashes if we try to process all the errors at once, needed to generate lists.
WordCountThresholdForSpellingErrors=20000

[Highlight Colors]
000000000/166175201=1
255255255/000000000=1
255255255/212208200=1
192192192/000000000=1
000000000/162181205=1
000000000/167205240=1
000000000/179200232=1
067078084/199213227=1
033039045/167205240=1
038038038/135206250=1
059059059/254233156=1

[Information]
Title=Outlook

[OutputModes]
CONTROL_DESCRIPTION=1|2|2|Control Description
